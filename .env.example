# ==============================================================================
# Chirpify Analytics Platform — Environment Configuration
# Twelve-Factor App Factor III: Store config in the environment
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# AWS / LocalStack Settings
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/chirpify-events-queue
USE_MOCK_QUEUE=false

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chirpify_user
POSTGRES_PASSWORD=chirpify_secure_pass
POSTGRES_DB=chirpify_analytics

# Redis In-Memory Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
